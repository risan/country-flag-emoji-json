---
import CopyButton from './CopyButton.astro';
import { flags, normalize } from '../data';

const rows = [
  { id: 'emoji', label: 'Emoji' },
  { id: 'code', label: 'Code' },
  { id: 'unicode', label: 'Unicode' },
  { id: 'url', label: 'Image URL' },
  { id: 'img', label: 'HTML' },
  { id: 'svg', label: 'SVG' },
];
---

<section id="flags" aria-labelledby="flags-title" class="border-t border-line pt-8">
  <div class="mb-4 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
    <h2 id="flags-title" class="text-xl font-semibold tracking-tight">
      All flags <span id="flag-count" class="ml-1 font-mono text-base font-normal text-subtle">{flags.length}</span>
    </h2>
    <p id="flag-status" class="sr-only" aria-live="polite"></p>

    <div class="relative w-full sm:w-72">
      <label for="flag-search" class="sr-only">Search flags by name, code or emoji</label>
      <svg class="pointer-events-none absolute left-2.5 top-1/2 size-4 -translate-y-1/2 text-subtle" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <circle cx="7" cy="7" r="4.5"></circle>
        <path d="m10.5 10.5 3 3" stroke-linecap="round"></path>
      </svg>
      <input
        id="flag-search"
        type="search"
        autocomplete="off"
        spellcheck="false"
        placeholder="Search name, code or emoji"
        class="h-9 w-full rounded-md border border-line bg-bg pl-8 pr-8 text-sm outline-none transition-colors placeholder:text-subtle hover:border-zinc-300 focus:border-link"
      />
      <kbd class="pointer-events-none absolute right-2 top-1/2 hidden h-5 -translate-y-1/2 items-center rounded-sm border border-line px-1.5 font-mono text-[11px] text-subtle sm:flex" aria-hidden="true">/</kbd>
    </div>
  </div>

  <p class="mb-3 text-sm text-muted">Click a flag to copy its emoji, code, Unicode, image URL or SVG.</p>

  <ul id="flag-grid" class="-mx-2 grid grid-cols-1 gap-x-4 min-[480px]:grid-cols-2 md:grid-cols-3 lg:grid-cols-4">
    {
      flags.map((flag, index) => (
        <li data-search={normalize(`${flag.name} ${flag.code} ${flag.emoji}`)}>
          <button
            type="button"
            data-code={flag.code}
            data-name={flag.name}
            data-emoji={flag.emoji}
            data-unicode={flag.unicode}
            data-image={flag.image}
            title={flag.name}
            class="flex h-9 w-full items-center gap-2 rounded-sm px-2 text-left transition-colors hover:bg-hover"
          >
            <img
              src={`/images/${flag.code}.svg`}
              alt=""
              width="32"
              height="32"
              loading={index < 40 ? 'eager' : 'lazy'}
              decoding="async"
              class="size-8 shrink-0"
            />
            <span class="min-w-0 flex-1 truncate text-sm">{flag.name}</span>
            <span class="shrink-0 font-mono text-xs text-subtle">{flag.code}</span>
          </button>
        </li>
      ))
    }
  </ul>

  <div id="flag-empty" hidden class="py-10 text-center">
    <p class="font-medium">No flags found</p>
    <p class="mt-1 text-sm text-muted">Try a country name, a code such as <code class="font-mono">DE</code>, or paste an emoji.</p>
  </div>

  <dialog
    id="flag-dialog"
    aria-labelledby="dialog-name"
    class="m-auto w-[min(calc(100vw-2rem),32rem)] max-h-[90vh] overflow-y-auto rounded-md border border-line bg-bg p-0 text-fg shadow-xl"
  >
    <div class="flex items-center gap-3 border-b border-line py-3 pl-4 pr-2">
      <img id="dialog-image" alt="" width="56" height="56" class="-my-1 size-14 shrink-0" />
      <div class="min-w-0 flex-1">
        <h3 id="dialog-name" class="truncate text-lg font-semibold leading-tight"></h3>
        <p id="dialog-code" class="font-mono text-[13px] text-subtle"></p>
      </div>
      <button
        type="button"
        id="dialog-close"
        aria-label="Close"
        class="self-start rounded-sm p-1.5 text-muted transition-colors hover:bg-hover hover:text-fg"
      >
        <svg class="size-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <path d="m4 4 8 8M12 4l-8 8" stroke-linecap="round"></path>
        </svg>
      </button>
    </div>

    <dl class="divide-y divide-line">
      {
        rows.map((row) => (
          <div class="grid grid-cols-[5.5rem_minmax(0,1fr)_auto] items-center gap-3 py-1.5 pl-4 pr-2">
            <dt class="text-[13px] text-muted">{row.label}</dt>
            <dd id={`value-${row.id}`} class:list={['truncate font-mono', row.id === 'emoji' ? 'text-xl leading-8' : 'text-[13px] leading-8']} />
            <CopyButton source={`#value-${row.id}`} label={row.label} />
          </div>
        ))
      }
    </dl>
  </dialog>
</section>

<script>
  const search = document.querySelector<HTMLInputElement>('#flag-search')!;
  const count = document.querySelector<HTMLElement>('#flag-count')!;
  const status = document.querySelector<HTMLElement>('#flag-status')!;
  const empty = document.querySelector<HTMLElement>('#flag-empty')!;
  const dialog = document.querySelector<HTMLDialogElement>('#flag-dialog')!;
  const items = [...document.querySelectorAll<HTMLElement>('#flag-grid > li')];
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('#flag-grid button')];

  const normalize = (text: string) => text.normalize('NFD').replace(/\p{M}/gu, '').toLowerCase();
  const field = (id: string) => document.querySelector<HTMLElement>(`#value-${id}`)!;
  const svgCopyButton = document.querySelector<HTMLButtonElement>('[data-copy-source="#value-svg"]')!;

  let latestRequest = 0;
  let shownCode = '';

  function filter() {
    const terms = normalize(search.value).split(/\s+/).filter(Boolean);
    let visible = 0;

    for (const item of items) {
      const matches = terms.every((term) => item.dataset.search!.includes(term));
      item.hidden = !matches;

      if (matches) {
        visible++;
      }
    }

    count.textContent = String(visible);
    status.textContent = `${visible} ${visible === 1 ? 'flag' : 'flags'} found`;
    empty.hidden = visible > 0;
  }

  function setValue(id: string, value: string) {
    const element = field(id);
    element.textContent = value;
    element.dataset.full = value;
  }

  async function open(button: HTMLButtonElement) {
    const { code, name, emoji, unicode, image } = button.dataset as Record<string, string>;
    const localImage = `/images/${code}.svg`;
    const picture = document.querySelector<HTMLImageElement>('#dialog-image')!;

    picture.src = localImage;
    picture.alt = `Flag of ${name}`;
    document.querySelector('#dialog-name')!.textContent = name;
    document.querySelector('#dialog-code')!.textContent = code;

    setValue('emoji', emoji);
    setValue('code', code);
    setValue('unicode', unicode);
    setValue('url', image);
    setValue('img', `<img src="${image}" alt="Flag of ${name}" width="32" height="32">`);
    setValue('svg', 'Loading...');
    svgCopyButton.disabled = true;

    shownCode = code;
    const request = ++latestRequest;

    if (!dialog.open) {
      dialog.showModal();
    }

    if (location.hash !== `#${code}`) {
      history.replaceState(null, '', `#${code}`);
    }

    try {
      const response = await fetch(localImage);

      if (!response.ok) {
        throw new Error(String(response.status));
      }

      const markup = await response.text();

      if (request === latestRequest) {
        setValue('svg', markup.trim());
        svgCopyButton.disabled = false;
      }
    } catch {
      if (request === latestRequest) {
        setValue('svg', 'Could not load the SVG.');
      }
    }
  }

  function codeFromHash() {
    try {
      return decodeURIComponent(location.hash.slice(1)).toUpperCase();
    } catch {
      return '';
    }
  }

  function openFromHash() {
    const code = codeFromHash();
    const button = buttons.find((candidate) => candidate.dataset.code === code);

    if (button) {
      open(button);
    } else if (dialog.open) {
      dialog.close();
    }
  }

  search.addEventListener('input', filter);

  search.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && search.value) {
      search.value = '';
      filter();
    }
  });

  for (const button of buttons) {
    button.addEventListener('click', () => open(button));
  }

  document.querySelector('#dialog-close')!.addEventListener('click', () => dialog.close());

  dialog.addEventListener('click', (event) => {
    if (event.target === dialog) {
      dialog.close();
    }
  });

  dialog.addEventListener('close', () => {
    if (codeFromHash() === shownCode) {
      history.replaceState(null, '', location.pathname + location.search);
    }

    shownCode = '';
  });

  document.addEventListener('keydown', (event) => {
    const target = event.target as HTMLElement;
    const typing = target.matches('input, textarea, select, [contenteditable]');

    if (event.key === '/' && !typing && !event.metaKey && !event.ctrlKey && !event.altKey && !dialog.open) {
      event.preventDefault();
      search.focus();
      search.select();
    }
  });

  window.addEventListener('hashchange', openFromHash);

  if (location.hash) {
    openFromHash();
  }
</script>
