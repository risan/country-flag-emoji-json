---
import CodeBlock from './CodeBlock.astro';
import { cdn } from '../data';

const tabs = [
  {
    id: 'cdn',
    title: 'CDN',
    intro: 'Fetch the JSON from jsDelivr. Nothing to install.',
    blocks: [
      {
        title: 'JavaScript',
        lang: 'js',
        code: `const response = await fetch(
  '${cdn}/by-code.json'
);
const flags = await response.json();

flags.DE.name;  // "Germany"
flags.DE.emoji; // "🇩🇪"
flags.DE.image; // URL of the SVG image`,
      },
    ],
  },
  {
    id: 'npm',
    title: 'npm',
    intro: 'Install the package. It contains only JSON and SVG files.',
    blocks: [
      { title: 'Terminal', lang: 'sh', code: 'npm install country-flag-emoji-json' },
      { title: 'CommonJS', lang: 'js', code: "const flags = require('country-flag-emoji-json');" },
      {
        title: 'ES modules (Node.js 18.20+ or a bundler)',
        lang: 'js',
        code: "import flags from 'country-flag-emoji-json' with { type: 'json' };",
      },
    ],
  },
  {
    id: 'html',
    title: 'HTML',
    intro: 'Show a flag as an image. It looks the same on every system, Windows included.',
    blocks: [
      {
        title: 'HTML',
        lang: 'html',
        code: `<img
  src="${cdn}/images/DE.svg"
  alt="Flag of Germany"
  width="32"
  height="32"
>`,
      },
    ],
  },
] as const;
---

<div id="quickstart">
  <div role="tablist" aria-label="Quick start" class="flex gap-5 border-b border-line">
    {
      tabs.map((tab, index) => (
        <button
          type="button"
          role="tab"
          id={`tab-${tab.id}`}
          aria-controls={`panel-${tab.id}`}
          aria-selected={index === 0 ? 'true' : 'false'}
          tabindex={index === 0 ? 0 : -1}
          class="-mb-px border-b-2 border-transparent pb-2 text-sm font-medium text-muted transition-colors hover:text-fg aria-selected:border-fg aria-selected:text-fg"
        >
          {tab.title}
        </button>
      ))
    }
  </div>

  {
    tabs.map((tab, index) => (
      <div role="tabpanel" id={`panel-${tab.id}`} aria-labelledby={`tab-${tab.id}`} hidden={index !== 0} class="space-y-3 pt-4">
        <p class="text-muted">{tab.intro}</p>
        {tab.blocks.map((block, blockIndex) => (
          <CodeBlock id={`snippet-${tab.id}-${blockIndex}`} code={block.code} lang={block.lang} title={block.title} />
        ))}
      </div>
    ))
  }
</div>

<script>
  const root = document.querySelector('#quickstart')!;
  const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];

  function select(tab: HTMLButtonElement) {
    for (const other of tabs) {
      const active = other === tab;
      other.setAttribute('aria-selected', String(active));
      other.tabIndex = active ? 0 : -1;
      root.querySelector<HTMLElement>(`#${other.getAttribute('aria-controls')}`)!.hidden = !active;
    }

    tab.focus();
  }

  for (const [index, tab] of tabs.entries()) {
    tab.addEventListener('click', () => select(tab));

    tab.addEventListener('keydown', (event) => {
      const step = event.key === 'ArrowRight' ? 1 : event.key === 'ArrowLeft' ? -1 : 0;

      if (step) {
        event.preventDefault();
        select(tabs[(index + step + tabs.length) % tabs.length]);
      }
    });
  }
</script>
