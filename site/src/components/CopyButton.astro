---
interface Props {
  source: string;
  label?: string;
  text?: string;
  class?: string;
}

const { source, label = 'what', text = 'Copy', class: className = '' } = Astro.props;
---

<button
  type="button"
  data-copy-source={source}
  data-label={text}
  aria-label={`Copy ${label}`}
  class:list={[
    'inline-flex h-7 shrink-0 items-center whitespace-nowrap gap-1.5 rounded-sm px-2 text-[12.5px] font-medium text-muted transition-colors enabled:hover:bg-hover enabled:hover:text-fg disabled:cursor-not-allowed disabled:opacity-40 data-[copied]:text-[#15803d]',
    className,
  ]}
>
  <svg class="copy-icon size-3.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
    <rect x="5.5" y="5.5" width="8" height="8" rx="1"></rect>
    <path d="M10.5 3.5V3a1 1 0 0 0-1-1h-6a1 1 0 0 0-1 1v6.5a1 1 0 0 0 1 1h.5"></path>
  </svg>
  <svg class="copy-check size-3.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
    <path d="m3 8.5 3.2 3L13 4.5" stroke-linecap="round" stroke-linejoin="round"></path>
  </svg>
  <span class="copy-label" aria-live="polite">{text}</span>
</button>
