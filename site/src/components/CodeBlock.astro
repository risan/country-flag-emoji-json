---
import { Code } from 'astro:components';
import CopyButton from './CopyButton.astro';

interface Props {
  id: string;
  code: string;
  lang: 'js' | 'json' | 'html' | 'css' | 'sh';
  title: string;
}

const { id, code, lang, title } = Astro.props;
---

<div class="overflow-hidden rounded-md border border-line bg-code">
  <div class="flex h-9 items-center justify-between border-b border-line pl-3.5 pr-1">
    <span class="font-mono text-[12px] text-subtle">{title}</span>
    <CopyButton source={`#${id}`} label={title} />
  </div>
  <div id={id} data-full={code}>
    <Code code={code} lang={lang} theme="github-light" class="px-3.5 py-3 font-mono text-[13px] leading-[1.7]" />
  </div>
</div>
