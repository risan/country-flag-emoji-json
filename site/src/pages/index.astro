---
import Docs from '../components/Docs.astro';
import FlagBrowser from '../components/FlagBrowser.astro';
import QuickStart from '../components/QuickStart.astro';
import Layout from '../layouts/Layout.astro';
import { authorUrl, flags, npmUrl, repoUrl, version } from '../data';

const contents = [
  { id: 'quick-start', title: 'Quick start' },
  { id: 'files', title: 'Files' },
  { id: 'fields', title: 'Fields' },
  { id: 'special-codes', title: 'Special codes' },
  { id: 'windows', title: 'Flags on Windows' },
  { id: 'upgrading', title: 'Upgrading from v2' },
  { id: 'license', title: 'License' },
  { id: 'flags', title: 'All flags' },
];

const navLink = 'text-sm text-muted transition-colors hover:text-fg';
const link = 'text-link underline decoration-link/30 underline-offset-[3px] hover:decoration-link';
---

<Layout>
  <header class="sticky top-0 z-20 border-b border-line bg-bg/95 backdrop-blur-sm">
    <div class="mx-auto flex h-12 max-w-[68rem] items-center justify-between gap-4 px-5">
      <a href="/" class="flex min-w-0 items-center gap-2">
        <img src="/favicon.svg" alt="" width="20" height="20" class="size-5 shrink-0" />
        <span class="truncate font-mono text-sm font-medium">country-flag-emoji-json</span>
        <span class="hidden font-mono text-xs text-subtle min-[400px]:inline">v{version}</span>
      </a>

      <nav aria-label="Main" class="flex shrink-0 items-center gap-5">
        <a href="#files" class={`${navLink} hidden sm:block`}>Docs</a>
        <a href="#flags" class={navLink}>Flags</a>
        <a href={npmUrl} class={`${navLink} hidden sm:block`}>npm</a>
        <a href={repoUrl} class={navLink}>GitHub</a>
      </nav>
    </div>
  </header>

  <main>
    <div class="mx-auto max-w-[68rem] px-5 lg:grid lg:grid-cols-[11rem_minmax(0,1fr)] lg:gap-x-14">
      <aside class="hidden lg:block">
        <nav aria-label="On this page" class="sticky top-12 pt-10">
          <p class="mb-2 text-[13px] font-medium">On this page</p>
          <ul id="toc" class="border-l border-line text-[13px]">
            {
              contents.map((item) => (
                <li>
                  <a
                    href={`#${item.id}`}
                    class="-ml-px block border-l border-transparent py-1 pl-3 text-muted transition-colors hover:text-fg aria-[current=true]:border-fg aria-[current=true]:text-fg"
                  >
                    {item.title}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </aside>

      <div class="min-w-0 space-y-10 pb-10 pt-10">
        <div>
          <h1 class="text-[28px] font-semibold leading-tight tracking-tight">Country flag emojis as JSON</h1>
          <p class="mt-3 max-w-[40rem] text-base text-muted">
            All {flags.length} flag emojis from Unicode 18.0. Each flag has a name, an ISO code, the emoji, its Unicode code points, and an SVG image. Use it from a CDN or install it from npm.
          </p>
        </div>

        <section id="quick-start" aria-labelledby="quick-start-title">
          <h2 id="quick-start-title" class="sr-only">Quick start</h2>
          <QuickStart />
        </section>

        <Docs />
      </div>
    </div>

    <div class="mx-auto max-w-[68rem] px-5 pb-16">
      <FlagBrowser />
    </div>
  </main>

  <footer class="border-t border-line">
    <div class="mx-auto flex max-w-[68rem] flex-col gap-1 px-5 py-6 text-[13px] text-muted sm:flex-row sm:justify-between">
      <p>Made by <a class={link} href={authorUrl}>Risan Bagja Pradana</a>. Licensed under CC BY-SA 4.0.</p>
      <p>Flag images by <a class={link} href="https://openmoji.org">OpenMoji</a>.</p>
    </div>
  </footer>
</Layout>

<script>
  const links = [...document.querySelectorAll<HTMLAnchorElement>('#toc a')];
  const sections = links.map((link) => document.querySelector<HTMLElement>(link.hash)!);

  function markCurrent() {
    const line = window.innerHeight * 0.3;
    let current = 0;

    for (const [index, section] of sections.entries()) {
      if (section.getBoundingClientRect().top <= line) {
        current = index;
      }
    }

    for (const [index, link] of links.entries()) {
      link.setAttribute('aria-current', String(index === current));
    }
  }

  markCurrent();
  window.addEventListener('scroll', markCurrent, { passive: true });
</script>
