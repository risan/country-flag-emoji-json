---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page not found | country-flag-emoji-json" noindex>
  <main class="mx-auto flex min-h-screen max-w-md flex-col items-start justify-center px-5">
    <p class="font-mono text-sm text-subtle">404</p>
    <h1 class="mt-1 text-2xl font-semibold tracking-tight">Page not found</h1>
    <p class="mt-2 text-muted">This page does not exist. The docs and all the flags are on the home page.</p>
    <a href="/" class="mt-5 text-sm font-medium text-link underline decoration-link/30 underline-offset-[3px] hover:decoration-link">Go to the home page</a>
  </main>
</Layout>
