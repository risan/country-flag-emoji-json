---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page not found | country-flag-emoji-json" noindex>
  <main class="mx-auto flex min-h-screen max-w-xl flex-col items-center justify-center px-4 text-center">
    <p class="text-6xl" aria-hidden="true">🏴‍☠️</p>
    <h1 class="mt-6 text-3xl font-semibold tracking-tight">Page not found</h1>
    <p class="mt-2 text-muted">This page does not exist. The flags are all on the home page.</p>
    <a
      href="/"
      class="mt-6 rounded-lg bg-accent px-4 py-2 text-sm font-medium text-accent-fg transition hover:opacity-90"
    >
      Back to the flags
    </a>
  </main>
</Layout>
